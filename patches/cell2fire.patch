+void
+Cell2Fire::ActivateTimedFirebreaks()
+{
+    if (this->TimedFirebreakPoints.empty()) return;
+    const int minute = this->fire_period[this->year - 1];
+    const std::string eventPath = this->args.OutFolder + "timed_firebreak_events.csv";
+    std::ifstream existing(eventPath);
+    const bool needsHeader = !existing.good() || existing.peek() == std::ifstream::traits_type::eof();
+    existing.close();
+    std::ofstream events(eventPath, std::ios::app);
+    if (needsHeader) events << "minute,cell,status\n";
+    for (const auto& scheduled : this->TimedFirebreakPoints)
+    {
+        if (scheduled.first != minute) continue;
+        const int cell = scheduled.second;
+        if (cell < 1 || cell > this->nCells || this->nonBurnableCells.count(cell) > 0)
+        {
+            events << minute << "," << cell << ",unavailable\n";
+            continue;
+        }
+        if (this->burntCells.count(cell) > 0 || this->burningCells.count(cell) > 0)
+        {
+            events << minute << "," << cell << ",breached\n";
+            continue;
+        }
+        this->fTypeCells[cell - 1] = 0;
+        this->fTypeCells2[cell - 1] = "NonBurnable";
+        this->statusCells[cell - 1] = 3;
+        this->availCells.erase(cell);
+        this->Cells_Obj.erase(cell);
+        this->harvestCells.insert(cell);
+        events << minute << "," << cell << ",activated\n";
+    }
+}
+
+void
+Cell2Fire::InjectScheduledIgnitions()
+{
+    const int minute = this->fire_period[this->year - 1];
+    const std::string eventPath = this->args.OutFolder + "ignition_events.csv";
+    std::ifstream existing(eventPath);
+    const bool needsHeader = !existing.good() || existing.peek() == std::ifstream::traits_type::eof();
+    existing.close();
+    std::ofstream events(eventPath, std::ios::app);
+    if (needsHeader) events << "minute,cell,status\n";
+
+    for (const auto& scheduled : this->ScheduledIgnitionPoints)
+    {
+        if (scheduled.first != minute) continue;
+        const int cell = scheduled.second;
+        if (cell < 1 || cell > this->nCells || this->nonBurnableCells.count(cell) > 0 || this->harvestCells.count(cell) > 0)
+        {
+            events << minute << "," << cell << ",unavailable\n";
+            continue;
+        }
+        if (this->burntCells.count(cell) > 0 || this->burningCells.count(cell) > 0)
+        {
+            events << minute << "," << cell << ",already_reached\n";
+            continue;
+        }
+        if (this->Cells_Obj.find(cell) == this->Cells_Obj.end()) this->InitCell(cell);
+        auto it = this->Cells_Obj.find(cell);
+        std::vector<int> points = {cell};
+        if (it->second.ignition(minute, this->year, points, &df[cell - 1], this->coef_ptr,
+                                this->args_ptr, &(this->wdf[this->weatherPeriod]), this->activeCrown,
+                                this->perimeterCells))
+        {
+            this->statusCells[cell - 1] = 1;
+            this->burningCells.insert(cell);
+            this->burntCells.insert(cell);
+            this->availCells.erase(cell);
+            this->nIgnitions++;
+            events << minute << "," << cell << ",ignited\n";
+        }
+        else
+        {
+            events << minute << "," << cell << ",unavailable\n";
+        }
+    }
+}
